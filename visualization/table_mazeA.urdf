<?xml version="1.0"?>
<robot name="table">

  <material name="crs_light_grey"><color rgba="0.72 0.74 0.76 1.0"/></material>
  <material name="crs_dark_grey"><color rgba="0.24 0.26 0.28 1.0"/></material>
  <material name="crs_orange"><color rgba="0.85 0.32 0.08 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0175"/>
      <geometry><cylinder radius="0.07" length="0.035"/></geometry>
      <material name="crs_light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075"/>
      <geometry><cylinder radius="0.07" length="0.035"/></geometry>
    </collision>
  </link>

  <link name="top_surface_center">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="crs_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
  </link>

  <joint name="table_rotation" type="revolute">
    <parent link="base_link"/><child link="top_surface_center"/>
    <origin xyz="0 0 0.035"/><axis xyz="0 0 1"/>
    <limit velocity="0.226"/>
  </joint>

  <link name="maze_bottom_center_x">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="crs_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>s
    </collision>
  </link>

  <link name="maze_bottom_center_xy">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
      <material name="crs_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>s
    </collision>
  </link>

  <joint name="maze_eccentricity_x" type="prismatic">
    <parent link="top_surface_center"/><child link="maze_bottom_center_x"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
  </joint>

  <joint name="maze_eccentricity_y" type="prismatic">
    <parent link="maze_bottom_center_x"/><child link="maze_bottom_center_xy"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="maze_bottom">
    <visual>
      <origin xyz="0 0 0.0175"/>
      <geometry><box size="0.125 0.125 0.035" length="0.1802"/></geometry>
    </visual>
        
    <!-- MAZE A -->
    <visual>
      <origin xyz="0 0 0.135"/>
      <geometry><box size="0.01 0.01 0.2" /></geometry>
      <material name="crs_orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.0175"/>
      <geometry><box size="0.125 0.125 0.035"/></geometry>
    </collision>
  </link>

  <joint name="maze_rotation" type="revolute">
    <parent link="maze_bottom_center_xy"/><child link="maze_bottom"/>
    <origin xyz="0 0 0"/><axis xyz="0 0 1"/>
  </joint>


</robot>
