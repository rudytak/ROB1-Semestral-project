<robot name="simple_robot">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.3 0.3 0.3"/>
            </geometry>
            
            <material name="Cyan">
                <color rgba="0 1.0 1.0 0.5"/>
            </material>
        </visual>
    </link>

    <link name="link1">
        <visual>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.5"/>
            </geometry>
            
            <material>
                <color rgba="1.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j1" type="revolute">
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <parent link="base_link"/>
        <child link="link1"/>
        <limit lower="-1.57079" upper="1.57079" />
    </joint>

    <link name="sphere1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
            
            <material>
                <color rgba="1.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j2" type="fixed">
        <origin xyz="0 0 0.5" rpy="0 0 0"/>
        <parent link="link1"/>
        <child link="sphere1"/>
    </joint>

    <link name="link2">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
            
            <material>
                <color rgba="0.0 1.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j3" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0" />
        <parent link="sphere1"/>
        <child link="link2"/>
        <limit lower="-1.57079" upper="1.57079" />
    </joint>


    <link name="link3">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
            
            <material>
                <color rgba="1.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j4" type="revolute">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
        <parent link="link2"/>
        <child link="link3"/>
        <limit lower="-1.57079" upper="1.57079" />
    </joint>

    <link name="sphere2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.06"/>
            </geometry>
            
            <material>
                <color rgba="1.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j5" type="fixed">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <parent link="link3"/>
        <child link="sphere2"/>
    </joint>

    <link name="link4">
        <visual>
            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.25"/>
            </geometry>
            
            <material>
                <color rgba="1.0 0.0 0.0 0.5"/>
            </material>
        </visual>
    </link>

    <joint name="j6" type="revolute">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="1 0 0" />
        <parent link="sphere2"/>
        <child link="link4"/>
        <limit lower="-1.57079" upper="1.57079" />
    </joint>

    <link name="end_effector">
    </link>

    <joint name="j7" type="fixed">
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <parent link="link4"/>
        <child link="end_effector"/>
    </joint>

</robot>