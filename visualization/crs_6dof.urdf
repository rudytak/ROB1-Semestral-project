<?xml version="1.0"?>
<robot name="crs_6dof_approx">

  <!--
    Parametric approximation of a 6-axis CRS-style industrial robot.
    Source: user-provided specification photographs.
    Important: this is NOT an OEM-verified model or an exact CAD reconstruction.
    Approximate dimensions interpreted from the reach drawing:
      base-to-shoulder height: 330.2 mm
      shoulder-to-elbow:      330.2 mm
      elbow-to-wrist:         304.8 mm
      wrist stage offsets:     76.2 mm + 76.2 mm
    The resulting nominal shoulder-to-flange reach is about 787 mm.
    Geometry, masses, inertias and effort limits are placeholders and must be
    replaced/validated before simulation for dynamics or real hardware use.
    URDF has no standard acceleration-limit field; see notes accompanying file.
  -->

  <material name="crs_light_grey"><color rgba="0.72 0.74 0.76 1.0"/></material>
  <material name="crs_dark_grey"><color rgba="0.24 0.26 0.28 1.0"/></material>
  <material name="crs_orange"><color rgba="0.85 0.32 0.08 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.075"/>
      <geometry><cylinder radius="0.10" length="0.15"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.075"/>
      <geometry><cylinder radius="0.10" length="0.15"/></geometry>
    </collision>
  </link>

  <link name="link_1_waist">
    <visual>
      <origin xyz="0 0 0.0901"/>
      <geometry><cylinder radius="0.10" length="0.1802"/></geometry>
      <material name="crs_light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0901"/>
      <geometry><cylinder radius="0.10" length="0.1802"/></geometry>
    </collision>
  </link>

  <joint name="J1_waist" type="revolute">
    <parent link="base_link"/><child link="link_1_waist"/>
    <origin xyz="0 0 0.15"/><axis xyz="0 0 1"/>
    <limit lower="-3.054326" upper="3.054326" effort="150" velocity="3.141593"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_2_upper_arm">
    <visual>
      <origin xyz="0 0 0.1524" />
      <geometry><cylinder radius="0.075" length="0.3048"/></geometry>
      <material name="crs_light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.105"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1524" />
      <geometry><cylinder radius="0.065" length="0.3048"/></geometry>
    </collision>
  </link>

  <joint name="J2_shoulder" type="revolute">
    <parent link="link_1_waist"/><child link="link_2_upper_arm"/>
    <origin xyz="0 0 0.1802"/><axis xyz="0 1 0"/>
    <limit lower="-1.570796" upper="1.570796" effort="150" velocity="3.141593"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_3_forearm">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.060" length="0.10"/></geometry>
      <material name="crs_light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.085"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.052" length="0.10"/></geometry>
    </collision>
  </link>

  <joint name="J3_elbow" type="revolute">
    <parent link="link_2_upper_arm"/><child link="link_3_forearm"/>
    <origin xyz="0 0 0.3302"/><axis xyz="0 1 0"/>
    <limit lower="-1.919862" upper="1.919862" effort="100" velocity="3.141593"/>
    <dynamics damping="0.15" friction="0.04"/>
  </joint>

  <link name="link_4_wrist_rotate">
    <visual>
      <origin xyz="0 0 0.1151"/>
      <geometry><cylinder radius="0.052" length="0.2302"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1151"/>
      <geometry><cylinder radius="0.045" length="0.2302"/></geometry>
    </collision>
  </link>

  <joint name="J4_wrist_rotate" type="revolute">
    <parent link="link_3_forearm"/><child link="link_4_wrist_rotate"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="35" velocity="2.984513"/>
    <dynamics damping="0.08" friction="0.02"/>
  </joint>

  <link name="link_5_wrist_pitch">
    <visual>
      <origin xyz="0 0 0.0381"/>
      <geometry><cylinder radius="0.03" length="0.0762"/></geometry>
      <material name="crs_light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0381"/>
      <geometry><cylinder radius="0.038" length="0.0762"/></geometry>
    </collision>
  </link>

  <joint name="J5_wrist_pitch" type="revolute">
    <parent link="link_4_wrist_rotate"/><child link="link_5_wrist_pitch"/>
    <origin xyz="0 0 0.2302"/><axis xyz="0 1 0"/>
    <limit lower="-1.832596" upper="1.832596" effort="25" velocity="3.019420"/>
    <dynamics damping="0.06" friction="0.02"/>
  </joint>

  <link name="link_6_tool_roll">
    <visual>
      <origin xyz="0 0 0.04825"/>
      <geometry><cylinder radius="0.036" length="0.0965"/></geometry>
      <material name="crs_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04825"/>
      <geometry><cylinder radius="0.032" length="0.0965"/></geometry>
    </collision>
  </link>

  <joint name="J6_tool_roll" type="revolute">
    <parent link="link_5_wrist_pitch"/><child link="link_6_tool_roll"/>
    <origin xyz="0 0 0.0762"/><axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="20" velocity="2.984513"/>
    <dynamics damping="0.05" friction="0.015"/>
  </joint>

  <link name="tool0">
    <visual>
      <origin xyz="-0.135 0 0.01"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
      <material name="crs_orange"/>
    </visual>
    <visual>
      <origin xyz="-0.05 0 0.01"/>
      <geometry><box size="0.1 0.02 0.02"/></geometry>
      <material name="crs_orange"/>
    </visual>
    <collision>
      <origin xyz="-0.135 0 0.01"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
    </collision>
  </link>

  <joint name="tool0_fixed" type="fixed">
    <parent link="link_6_tool_roll"/><child link="tool0"/>
    <origin xyz="0 0 0.0965"/>
  </joint>

</robot>
